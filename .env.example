# Local mode is the default and requires no database or login.
# Set `supabase` for the commercial web deployment.
ROLEGAIN_AUTH_MODE=local
ROLEGAIN_PUBLIC_ORIGIN=http://127.0.0.1:5173
ROLEGAIN_PROCESS_JOBS=true
ROLEGAIN_WORKER_CONCURRENCY=2
ROLEGAIN_COMPANY_RESEARCH_CONCURRENCY=2
ROLEGAIN_OBJECT_STORAGE=disabled

# Required when ROLEGAIN_AUTH_MODE=supabase.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
ROLEGAIN_DATABASE_SSL=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=rolegain-private

# Private /admin login. Set these only in the deployment secret store.
ROLEGAIN_ADMIN_USERNAME=replace-me
ROLEGAIN_ADMIN_PASSWORD=replace-me
ROLEGAIN_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# These VITE_ values are public and are compiled into the browser bundle.
VITE_ROLEGAIN_AUTH_MODE=local
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-me

# LLM provider configuration.
ROLEGAIN_LLM_TRANSPORT=api
ROLEGAIN_API_KEY=replace-me-with-provider-api-key
ROLEGAIN_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ROLEGAIN_API_MODEL=gemini-2.5-flash
ROLEGAIN_API_MAX_OUTPUT_TOKENS=16000
ROLEGAIN_API_OMIT_REASONING_EFFORT=false

# Calls requiring current public-web data use Gemini's native Google Search
# endpoint, then pass the grounded dossier through the schema-bound API call.
ROLEGAIN_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Optional; defaults to ROLEGAIN_API_MODEL.
ROLEGAIN_GEMINI_SEARCH_MODEL=

# Private Codex worker only. Mount this path on a persistent Railway volume.
ROLEGAIN_CODEX_HOME=/data/codex
