* text=auto eol=lf

# Windows command scripts require CRLF when executed by cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binary assets out of text normalization.
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
*.docx binary
*.zip binary
